# =============================================================================
# OCR Platform – Docker Compose (.env)
# Copy: cp .env.example .env  rồi chỉnh các giá trị có <...>
# =============================================================================

# --- Django ---
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=<đổi-thành-chuỗi-ngẫu-nhiên-mạnh>
DJANGO_ALLOWED_HOSTS=<ip-server>,ocr.rnd.lcs.com.vn,localhost,127.0.0.1
# Bắt buộc khi truy cập Admin qua HTTPS (domain phải khớp, có https://)
DJANGO_CSRF_TRUSTED_ORIGINS=https://ocr.rnd.lcs.com.vn
# Origin trình duyệt dùng khi gắn ảnh citation OpenWebUI (không slash cuối)
PUBLIC_BASE_URL=https://ocr.rnd.lcs.com.vn
# Bật nếu có nginx/traefik proxy HTTPS vào container port 8000
DJANGO_BEHIND_PROXY=1
# Proxy phía trước phải cho phép PDF lớn, nếu không request chết trước khi vào container
# (nginx: client_max_body_size 512m; proxy_read_timeout 600s; proxy_send_timeout 600s;)

# --- Web (docker-compose) ---
# Port trên host (đổi nếu 8000 đã bị container khác chiếm)
WEB_PORT=8000
# Folder PDF trên máy chủ — Sách chờ nhập có thể chọn file từ đây (không cần upload từ máy).
# Đường dẫn trên HOST; compose mount vào /app/inbox (readonly).
STAGED_PDF_INBOX_HOST=./inbox

# --- PostgreSQL ---
# Trong container: hostname = postgres (KHÔNG dùng 127.0.0.1)
POSTGRES_DB=ocr_platform
POSTGRES_USER=ocr_platform
POSTGRES_PASSWORD=<đổi-mật-khẩu-mạnh>
DATABASE_URL=postgres://ocr_platform:<mật-khẩu-giống-trên>@postgres:5432/ocr_platform

# --- Redis / Celery ---
# Trong container: hostname = redis (KHÔNG dùng localhost)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
# 0 = task OCR chạy queue gpu (worker-gpu). 1 = ép queue cpu (profile cpu-only)
CELERY_FORCE_CPU=0

# --- GPU (worker-gpu) ---
# Chỉ số card VẬT LÝ trên host — xem: nvidia-smi
# 0 = GPU đầu tiên, 1 = GPU thứ hai
GPU_DEVICE_IDS=0
# KHÔNG đặt CUDA_VISIBLE_DEVICES trong .env (docker-compose tự gán =0 trong container).
# Nếu đặt CUDA_VISIBLE_DEVICES=1 sẽ gây lỗi "torch.cuda.is_available(): False".

# --- Google Cloud credentials ---
# File JSON mount vào container tại /app/credentials/
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/global-axe-477808-s9-4570b736560b.json

# --- VLM (tùy chọn — cho bảng/công thức) ---
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=

# --- Google Document AI (tùy chọn — legacy) ---
DOCUMENT_AI_PROJECT_ID=global-axe-477808-s9
DOCUMENT_AI_LOCATION=us
# Để trống = tự tạo/tìm processor lần đầu. Hoặc điền ID sau khi đã tạo:
DOCUMENT_AI_OCR_PROCESSOR_ID=222df463c3822aa5
DOCUMENT_AI_LAYOUT_PROCESSOR_ID=ffc542c6f41ebd71

# --- Ollama (tùy chọn – chỉ khi dùng backend Ollama thay Document AI) ---
# Ollama chạy NGOÀI docker compose; worker phải reach được URL này
OLLAMA_BASE_URL=http://<ip-ollama>:11434
OLLAMA_MODEL=qwen2.5vl:32b

# --- vLLM (tùy chọn — LLM OpenAI-compatible, nhanh hơn Ollama) ---
# vLLM chạy NGOÀI docker compose. Base URL phải có /v1
# VLLM_BASE_URL=http://<ip-vllm>:8000/v1
# VLLM_MODEL=Qwen/Qwen2.5-32B-Instruct
# VLLM_API_KEY=

# --- MinIO / S3 (tùy chọn – lưu media trên object storage) ---
# Bỏ comment và điền nếu dùng S3 thay volume local
# S3_ENDPOINT_URL=http://minio:9000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION_NAME=us-east-1
# S3_BUCKET_MEDIA=ocr-media
