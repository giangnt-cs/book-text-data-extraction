FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    poppler-utils \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --upgrade pip setuptools wheel

RUN python -m pip install --no-cache-dir \
    torch torchvision \
    --index-url https://download.pytorch.org/whl/cpu

COPY requirements-worker-cpu.txt /app/requirements-worker-cpu.txt
COPY requirements-worker-base.txt /app/requirements-worker-base.txt
COPY requirements-web.txt /app/requirements-web.txt

RUN python -m pip install --no-cache-dir -r /app/requirements-worker-cpu.txt && \
    python -c "from doclayout_yolo import YOLOv10; print('doclayout_yolo OK')"

COPY . /app
ENV PYTHONPATH=/app:/app/backend

CMD ["celery", "-A", "ocr_platform.celery_app", "worker", "-l", "INFO", "-Q", "cpu", "-c", "2"]
